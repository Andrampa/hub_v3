# Optional deployment override for the standalone monitoring application.
# Production is the application default. Include the full base URL and update
# the hosting CSP frame-src policy when validating another monitoring origin.
VITE_MONITORING_DASHBOARD_URL=https://diem-monitoring.apps.fao.org/

# Optional deployment override for the public read-only FeatureServer view.
# By default the app resolves the stable configured AGOL view item ID.
# VITE_COUNTRY_EDITORIAL_SERVICE_URL=https://services.arcgis.com/.../FeatureServer

# Optional editor-managed Hub carousel and popup source. Production is the
# default channel. Use stg only in a staging deployment.
# VITE_HUB_PROMOTIONS_CHANNEL=prod
# VITE_HUB_PROMOTIONS_VIEW_ITEM_ID=
# VITE_HUB_PROMOTIONS_SERVICE_URL=https://services.arcgis.com/.../FeatureServer
